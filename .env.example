GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: use this when the app is behind a proxy or has a custom domain.
# NAANO_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Recommended in production. If omitted, the Google client secret is used as the signing key.
# AUTH_SESSION_SECRET=replace-with-a-long-random-secret
